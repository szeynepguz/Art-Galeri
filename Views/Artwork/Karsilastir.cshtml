@model IEnumerable<art_galeri.Models.Artwork>
@{ViewData["Title"] = "Eser Karşılaştırma";}

<div class="dashboard-container">
    <div class="dashboard-welcome mb-4">
        <h2><i class="bi bi-arrow-left-right"></i> Eser Karşılaştırma</h2>
        <p>Seçtiğiniz eserleri yan yana inceleyin.</p>
    </div>

    @if (Model != null && Model.Any())
    {
        <!-- Kaydet Butonu -->
        @if (Context.Session.GetInt32("UserID") != null)
        {
            <div class="panel-card mb-3 d-flex justify-content-between align-items-center">
                <div class="d-flex gap-2 align-items-center">
                    <i class="bi bi-bookmark text-accent" style="font-size:1.3rem;"></i>
                    <input type="text" id="karsilastirmaBaslik" class="form-control form-control-sm" placeholder="Karşılaştırma adı girin..." style="width:250px;" value="Eser Karşılaştırma - @DateTime.Now.ToString("dd.MM.yyyy")">
                </div>
                <button class="btn btn-sm btn-gold" onclick="kaydetKarsilastirma()">
                    <i class="bi bi-save me-1"></i>Karşılaştırmayı Kaydet
                </button>
            </div>
        }

        <div class="panel-card overflow-auto">
            <table class="table table-bordered table-custom text-center align-middle">
                <thead class="table-light">
                    <tr>
                        <th style="min-width: 200px;">Özellik</th>
                        @foreach (var item in Model)
                        {
                            <th style="min-width: 250px;">
                                <div class="d-flex flex-column align-items-center">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" style="width: 150px; height: 150px; object-fit: cover;" class="rounded shadow-sm mb-2">
                                    }
                                    else
                                    {
                                        <div style="width: 150px; height: 150px; background: #f8f9fa;" class="rounded shadow-sm mb-2 d-flex align-items-center justify-content-center">
                                            <span style="font-size: 3rem;">🎨</span>
                                        </div>
                                    }
                                    <h6 class="mb-0">@item.Title</h6>
                                    <a href="/Artwork/Detay/@item.ArtworkID" class="btn btn-sm btn-link text-gold">Detaylı İncele</a>
                                </div>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold">Sanatçı</td>
                        @foreach (var item in Model)
                        {
                            <td>@item.Artist?.Ad @item.Artist?.Soyad</td>
                        }
                    </tr>
                    <tr>
                        <td class="fw-bold">Kategori</td>
                        @foreach (var item in Model)
                        {
                            <td><span class="badge bg-light text-dark">@item.Kategori</span></td>
                        }
                    </tr>
                    <tr>
                        <td class="fw-bold">Fiyat</td>
                        @{
                            var fiyatlar = Model.Select(m => m.Price).ToList();
                            var minFiyat = fiyatlar.Min();
                        }
                        @foreach (var item in Model)
                        {
                            <td class="fw-bold @(item.Price == minFiyat ? "text-success" : "text-dark")" style="font-size: 1.1rem;">
                                @item.Price.ToString("N0") ₺
                                @if (item.Price == minFiyat && fiyatlar.Count(f => f == minFiyat) == 1) { <span class="badge bg-success ms-1" style="font-size:.6rem;">En Uygun</span> }
                            </td>
                        }
                    </tr>
                    <tr>
                        <td class="fw-bold">Görüntülenme</td>
                        @foreach (var item in Model)
                        {
                            <td><i class="bi bi-eye"></i> @item.GoruntulenmeSayisi</td>
                        }
                    </tr>
                    <tr>
                        <td class="fw-bold">Beğeni</td>
                        @foreach (var item in Model)
                        {
                            <td><i class="bi bi-heart"></i> @item.BegeniSayisi</td>
                        }
                    </tr>
                    <tr>
                        <td class="fw-bold">Yorum Sayısı</td>
                        @foreach (var item in Model)
                        {
                            <td><i class="bi bi-chat"></i> @item.YorumSayisi</td>
                        }
                    </tr>
                    <tr>
                        <td class="fw-bold">Değerlendirme</td>
                        @foreach (var item in Model)
                        {
                            <td>
                                <span class="stars">@for(int i=1;i<=5;i++){@(i<=Math.Round(item.OrtalamaPuan)?"⭐":"☆")}</span>
                                <div class="small text-muted">(@item.OrtalamaPuan.ToString("F1"))</div>
                            </td>
                        }
                    </tr>
                    <tr>
                        <td class="fw-bold">Yükleme Tarihi</td>
                        @foreach (var item in Model)
                        {
                            <td>@item.UploadDate.ToString("dd.MM.yyyy")</td>
                        }
                    </tr>
                    <tr>
                        <td></td>
                        @foreach (var item in Model)
                        {
                            <td>
                                <a href="/Siparis/Satin?artworkId=@item.ArtworkID" class="btn btn-accent w-100"><i class="bi bi-cart"></i> Satın Al</a>
                            </td>
                        }
                    </tr>
                </tbody>
            </table>
        </div>

    }
    else if (ViewBag.KayitliKarsilastirmalar == null || !((List<Karsilastirma>)ViewBag.KayitliKarsilastirmalar).Any())
    {
        <div class="empty-state">
            <div class="empty-icon">🤷</div>
            <h4>Karşılaştırılacak eser bulunamadı</h4>
            <p>Lütfen eserler listesinden en az iki eser seçin.</p>
            <a href="/Artwork" class="btn btn-gold mt-3">Eserlere Dön</a>
        </div>
    }

    <!-- Kayıtlı Karşılaştırmalar -->
    @if (ViewBag.KayitliKarsilastirmalar != null)
    {
        var kayitlar = (List<Karsilastirma>)ViewBag.KayitliKarsilastirmalar;
        if (kayitlar.Any())
        {
            <div class="panel-card mt-4">
                <div class="panel-title d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-bookmark-fill text-gold" style="color:var(--gold);"></i> Kayıtlı Eser Karşılaştırmalarınız</span>
                    @if (!(Model != null && Model.Any()))
                    {
                        <a href="/Artwork" class="btn btn-sm btn-outline-gold"><i class="bi bi-plus-lg"></i> Yeni Karşılaştırma Yap</a>
                    }
                </div>
                <div class="list-group">
                    @foreach (var k in kayitlar)
                    {
                        <a href="/Artwork/Karsilastir?ids=@k.IDler" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            <div>
                                <strong>@k.Baslik</strong>
                                <small class="text-muted d-block">@k.KayitTarihi.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</small>
                            </div>
                            <div class="d-flex align-items-center gap-3">
                                <span class="badge bg-light text-dark border">@k.IDler.Split(',').Length Eser</span>
                                <i class="bi bi-arrow-right text-gold"></i>
                            </div>
                        </a>
                    }
                </div>
            </div>
        }
    }
</div>

@section Scripts {
<script>
function kaydetKarsilastirma() {
    const baslik = document.getElementById('karsilastirmaBaslik').value || 'Eser Karşılaştırma';
    const params = new URLSearchParams(window.location.search);
    const ids = params.get('ids') || '';

    fetch('/Artwork/KarsilastirmaKaydet', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: `ids=${ids}&baslik=${encodeURIComponent(baslik)}`
    })
    .then(r => r.json())
    .then(d => {
        if (d.success) {
            alert(d.message);
            location.reload();
        } else {
            alert(d.message);
        }
    });
}
</script>
}
