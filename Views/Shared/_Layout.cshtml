<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Art Galeri - Sanat eserlerini keşfedin, atölyelere katılın, sanat dünyasıyla buluşun." />
    <title>@ViewData["Title"] - Art Galeri</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,400&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark shadow-lg">
            <div class="container">
                <a class="navbar-brand fw-bold" href="/">
                    <i class="bi bi-palette2"></i> ART GALERİ
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" href="/"><i class="bi bi-house"></i> Ana Sayfa</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Artwork"><i class="bi bi-images"></i> Eserler</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Etkinlik"><i class="bi bi-calendar-event"></i> Etkinlikler</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Kampanya"><i class="bi bi-megaphone"></i> Kampanyalar</a>
                        </li>
                        @if (Context.Session.GetInt32("UserID") != null)
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="/Favori"><i class="bi bi-heart"></i> Favorilerim</a>
                            </li>
                        }
                        @if (Context.Session.GetString("UserRole") == "Sanatci")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-warning" href="/Users/SanatciDashboard">
                                    <i class="bi bi-easel"></i> Sanatçı Paneli
                                </a>
                            </li>
                        }
                        @if (Context.Session.GetString("UserRole") == "Yonetici")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-warning" href="/Users/YoneticiDashboard">
                                    <i class="bi bi-speedometer2"></i> Yönetim Paneli
                                </a>
                            </li>
                        }
                        @if (Context.Session.GetString("UserRole") == "Egitmen")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-warning" href="/Users/EgitmenDashboard">
                                    <i class="bi bi-mortarboard"></i> Eğitmen Paneli
                                </a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link" href="/Users/Destek"><i class="bi bi-headset"></i> Destek</a>
                        </li>
                    </ul>
                    <div class="navbar-nav ms-auto align-items-center">
                        @if (Context.Session.GetInt32("UserID") != null)
                        {
                            <div class="dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" data-bs-toggle="dropdown">
                                    <div class="avatar-sm">@(Context.Session.GetString("UserAd")?[0])</div>
                                    <span>@Context.Session.GetString("UserAd")</span>
                                    <span class="badge-role">@Context.Session.GetString("UserRole")</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark">
                                    <li><a class="dropdown-item" href="/Users/Profil"><i class="bi bi-person-circle me-2"></i>Profilim</a></li>
                                    <li><a class="dropdown-item" href="/Users/Rezervasyonlarim"><i class="bi bi-calendar-check me-2"></i>Rezervasyonlarım</a></li>
                                    <li><a class="dropdown-item" href="/Users/Siparislerim"><i class="bi bi-bag-check me-2"></i>Siparişlerim</a></li>
                                    <li><a class="dropdown-item" href="/Favori"><i class="bi bi-heart me-2"></i>Favorilerim</a></li>
                                    <li><a class="dropdown-item" href="/Etkinlik/Karsilastir"><i class="bi bi-list-columns-reverse me-2"></i>Karşılaştırmalarım</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item text-danger" href="/Users/Logout"><i class="bi bi-box-arrow-right me-2"></i>Çıkış Yap</a></li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="nav-link px-3" href="/Users/Login"><i class="bi bi-box-arrow-in-right"></i> Giriş Yap</a>
                            <a class="btn btn-gold ms-2" href="/Users/Register">Kayıt Ol</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-custom alert-success alert-dismissible fade show mt-3" role="alert">
                <i class="bi bi-check-circle-fill"></i>
                <span>@TempData["SuccessMessage"]</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-custom alert-danger alert-dismissible fade show mt-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <span>@TempData["ErrorMessage"]</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-center">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <h6 class="text-warning fw-bold"><i class="bi bi-palette2"></i> ART GALERİ</h6>
                    <small class="text-muted">Sanatın Dijital Dünyası</small>
                </div>
                <div class="col-md-4 mb-3">
                    <h6 class="text-light">Hızlı Erişim</h6>
                    <div class="d-flex flex-column gap-1">
                        <a href="/Artwork" class="footer-link">Eserler</a>
                        <a href="/Etkinlik" class="footer-link">Etkinlikler</a>
                        <a href="/Users/Destek" class="footer-link">Destek</a>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <h6 class="text-light">Hesap</h6>
                    <div class="d-flex flex-column gap-1">
                        <a href="/Users/Login" class="footer-link">Giriş Yap</a>
                        <a href="/Users/Register" class="footer-link">Kayıt Ol</a>
                    </div>
                </div>
            </div>
            <hr class="border-secondary">
            <p class="mb-0 text-muted small">&copy; 2026 Art Galeri — Tüm hakları saklıdır.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>