<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Online Sanat Galerisi - Eserlerinizi sergileyin, atolyelere katilim, sanat dunyasi" />
    <title>@ViewData["Title"] - Art Galeri</title>

    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark shadow-lg mb-4">
            <div class="container">
                <a class="navbar-brand fw-bold" href="/">
                    <i class="bi bi-palette2"></i> ART GALERI
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" href="/"><i class="bi bi-house"></i> Ana Sayfa</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Users"><i class="bi bi-people"></i> Sanatcilar</a>
                        </li>
                        @if (Context.Session.GetString("UserRole") == "Sanatci")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-warning" href="/Artist/ArtistPanel">
                                    <i class="bi bi-easel"></i> Sanatci Paneli
                                </a>
                            </li>
                        }
                        @if (Context.Session.GetString("UserRole") == "Yonetici")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-warning" href="/Users/YoneticiDashboard">
                                    <i class="bi bi-speedometer2"></i> Yonetim Paneli
                                </a>
                            </li>
                        }
                        @if (Context.Session.GetString("UserRole") == "Egitmen")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-warning" href="/Users/EgitmenDashboard">
                                    <i class="bi bi-mortarboard"></i> Egitmen Paneli
                                </a>
                            </li>
                        }
                    </ul>

                    <div class="navbar-nav ms-auto align-items-center">
                        @if (Context.Session.GetInt32("UserID") != null)
                        {
                            <span class="nav-link text-light">
                                <i class="bi bi-person-circle"></i>
                                @Context.Session.GetString("UserAd") @Context.Session.GetString("UserSoyad")
                                <span class="badge bg-warning text-dark ms-1">@Context.Session.GetString("UserRole")</span>
                            </span>
                            <a class="btn btn-outline-gold btn-sm ms-2" href="/Users/Logout">
                                <i class="bi bi-box-arrow-right"></i> Cikis
                            </a>
                        }
                        else
                        {
                            <a class="nav-link px-3" href="/Users/Login">
                                <i class="bi bi-box-arrow-in-right"></i> Giris Yap
                            </a>
                            <a class="btn btn-gold ms-2" href="/Users/Register">Kayit Ol</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-custom alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill"></i>
                <span>@TempData["SuccessMessage"]</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-custom alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <span>@TempData["ErrorMessage"]</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-center">
        <div class="container">
            <p class="mb-1"><i class="bi bi-palette2"></i> &copy; 2026 - Art Galeri | Sanatin Dijital Dunyasi</p>
            <small class="text-muted">Trabzon'dan Sevgilerle</small>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>