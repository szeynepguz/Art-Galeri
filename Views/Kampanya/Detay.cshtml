@model art_galeri.Models.Kampanya
@{ViewData["Title"] = Model.Ad;}

<div class="dashboard-container">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Kampanya">Kampanyalar</a></li>
            <li class="breadcrumb-item active">@Model.Ad</li>
        </ol>
    </nav>

    <div class="panel-card mb-4 bg-gradient-gold text-white p-4 rounded-4 shadow">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="fw-bold mb-2">@Model.Ad</h1>
                <p class="lead mb-0">@Model.Aciklama</p>
                <div class="mt-3">
                    <span class="badge bg-white text-gold fs-6 px-3 py-2">Kupon: <strong>@Model.KuponKodu</strong></span>
                </div>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <div class="display-4 fw-bold">%@Model.IndirimOrani.ToString("N0")</div>
                <div class="text-uppercase small">İndirim Fırsatı</div>
            </div>
        </div>
    </div>

    <h4 class="section-title"><i class="bi bi-images"></i> Kampanyalı Eserler</h4>
    <div class="row g-4 mb-5">
        @foreach (var item in ViewBag.Eserler as List<art_galeri.Models.Artwork> ?? new List<art_galeri.Models.Artwork>())
        {
            <div class="col-lg-3 col-md-6">
                <div class="artwork-card h-100">
                    <div class="card-img-wrapper" style="height: 180px;">
                        @if (!string.IsNullOrEmpty(item.ImageUrl)) { <img src="@item.ImageUrl" class="card-img-top h-100 w-100 object-fit-cover"> }
                        else { <div class="h-100 w-100 bg-light d-flex align-items-center justify-content-center">🎨</div> }
                    </div>
                    <div class="card-body">
                        <h6 class="card-title">@item.Title</h6>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <div>
                                <span class="text-decoration-line-through text-muted small">@item.Price.ToString("N0") ₺</span>
                                <span class="fw-bold text-success d-block">@((item.Price * (1 - Model.IndirimOrani/100)).ToString("N0")) ₺</span>
                            </div>
                            <a href="/Artwork/Detay/@item.ArtworkID" class="btn btn-sm btn-outline-dark">İncele</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <h4 class="section-title"><i class="bi bi-calendar-event"></i> Kampanyalı Etkinlikler</h4>
    <div class="row g-4">
        @foreach (var e in ViewBag.Etkinlikler as List<art_galeri.Models.Etkinlik> ?? new List<art_galeri.Models.Etkinlik>())
        {
            <div class="col-lg-4 col-md-6">
                <div class="event-card">
                    <div class="p-3">
                        <h6 class="fw-bold mb-1">@e.Ad</h6>
                        <div class="small text-muted mb-3"><i class="bi bi-calendar3 me-1"></i> @e.Tarih.ToString("dd.MM.yyyy")</div>
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <span class="text-decoration-line-through text-muted small">@e.Ucret.ToString("N0") ₺</span>
                                <span class="fw-bold text-success d-block">@((e.Ucret * (1 - Model.IndirimOrani/100)).ToString("N0")) ₺</span>
                            </div>
                            <a href="/Etkinlik/Detay/@e.EtkinlikID" class="btn btn-sm btn-accent">Rezervasyon</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
.bg-gradient-gold {
    background: linear-gradient(135deg, #b8860b 0%, #daa520 100%);
}
.text-gold {
    color: #b8860b;
}
</style>
