@model IEnumerable<art_galeri.Models.Kampanya>
@{ViewData["Title"] = "Kampanyalar ve Fırsatlar";}

<div class="dashboard-container">
    <div class="dashboard-welcome mb-4">
        <h2><i class="bi bi-megaphone"></i> Kampanyalar & İndirimler</h2>
        <p>Sanatla buluşmanızı kolaylaştıran özel fırsatları kaçırmayın.</p>
    </div>

    <div class="row g-4">
        @foreach (var k in Model)
        {
            <div class="col-md-6">
                <div class="panel-card h-100 border-start border-gold border-4">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h4 class="fw-bold mb-0">@k.Ad</h4>
                        <span class="badge bg-danger">-%@k.IndirimOrani.ToString("N0")</span>
                    </div>
                    <p class="text-muted">@k.Aciklama</p>
                    <div class="bg-light p-2 rounded mb-3 d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-muted d-block">Kupon Kodu:</small>
                            <code class="fs-5 text-primary">@k.KuponKodu</code>
                        </div>
                        <button class="btn btn-sm btn-outline-primary" onclick="copyCode('@k.KuponKodu')"><i class="bi bi-clipboard"></i> Kopyala</button>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <small class="text-muted"><i class="bi bi-clock"></i> Son Gün: @k.BitisTarihi.ToString("dd.MM.yyyy")</small>
                        <a href="/Kampanya/Detay/@k.KampanyaID" class="btn btn-sm btn-gold">Fırsatları Gör</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
function copyCode(code) {
    navigator.clipboard.writeText(code);
    alert('Kupon kodu kopyalandı: ' + code);
}
</script>
}
