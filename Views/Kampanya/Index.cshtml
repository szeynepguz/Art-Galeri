@model IEnumerable<art_galeri.Models.Kampanya>
@{ViewData["Title"] = "Kampanyalar ve Fırsatlar";}

<div class="dashboard-container">
    <div class="dashboard-welcome mb-4">
        <h2><i class="bi bi-megaphone"></i> Kampanyalar & İndirimler</h2>
        <p>Sanatla buluşmanızı kolaylaştıran özel fırsatları kaçırmayın.</p>
    </div>

    @{
        var genelKampanyalar = ViewBag.GenelKampanyalar as List<art_galeri.Models.Kampanya> ?? new List<art_galeri.Models.Kampanya>();
        var ozelKampanyalar = ViewBag.OzelKampanyalar as List<art_galeri.Models.Kampanya> ?? new List<art_galeri.Models.Kampanya>();
    }

    @if (ozelKampanyalar.Any())
    {
        <div class="mb-4">
            <h4 class="section-title"><i class="bi bi-star-fill text-warning"></i> Size Özel Fırsatlar</h4>
            <div class="row g-4">
                @foreach (var k in ozelKampanyalar)
                {
                    <div class="col-md-6">
                        <div class="panel-card h-100" style="border:2px solid #daa520;background:linear-gradient(135deg,#fffbeb,#fef3c7);">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <span class="badge bg-warning text-dark mb-1"><i class="bi bi-star-fill"></i> Özel Fırsat</span>
                                    <h4 class="fw-bold mb-0">@k.Ad</h4>
                                </div>
                                <span class="badge bg-danger fs-6">-%@k.IndirimOrani.ToString("N0")</span>
                            </div>
                            <p class="text-muted">@k.Aciklama</p>
                            @if (k.HedefRol != null)
                            {
                                <div class="mb-2">
                                    <span class="badge bg-info"><i class="bi bi-person-badge"></i> @k.HedefRol.RolAdi üyelerine özel</span>
                                </div>
                            }
                            <div class="bg-white p-2 rounded mb-3 d-flex justify-content-between align-items-center">
                                <div>
                                    <small class="text-muted d-block">Kupon Kodu:</small>
                                    <code class="fs-5 text-primary">@k.KuponKodu</code>
                                </div>
                                <button class="btn btn-sm btn-outline-primary" onclick="copyCode('@k.KuponKodu')"><i class="bi bi-clipboard"></i> Kopyala</button>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <small class="text-muted"><i class="bi bi-clock"></i> Son Gün: @k.BitisTarihi.ToString("dd.MM.yyyy")</small>
                                <a href="/Kampanya/Detay/@k.KampanyaID" class="btn btn-sm btn-gold">Fırsatları Gör</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @if (genelKampanyalar.Any())
    {
        <h4 class="section-title"><i class="bi bi-tag-fill text-success"></i> Herkese Açık Kampanyalar</h4>
        <div class="row g-4">
            @foreach (var k in genelKampanyalar)
            {
                <div class="col-md-6">
                    <div class="panel-card h-100 border-start border-gold border-4">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h4 class="fw-bold mb-0">@k.Ad</h4>
                            <span class="badge bg-danger">-%@k.IndirimOrani.ToString("N0")</span>
                        </div>
                        <p class="text-muted">@k.Aciklama</p>
                        <div class="bg-light p-2 rounded mb-3 d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted d-block">Kupon Kodu:</small>
                                <code class="fs-5 text-primary">@k.KuponKodu</code>
                            </div>
                            <button class="btn btn-sm btn-outline-primary" onclick="copyCode('@k.KuponKodu')"><i class="bi bi-clipboard"></i> Kopyala</button>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <small class="text-muted"><i class="bi bi-clock"></i> Son Gün: @k.BitisTarihi.ToString("dd.MM.yyyy")</small>
                            <a href="/Kampanya/Detay/@k.KampanyaID" class="btn btn-sm btn-gold">Fırsatları Gör</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (!genelKampanyalar.Any() && !ozelKampanyalar.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">🏷️</div>
            <h4>Şu an aktif kampanya bulunmuyor</h4>
            <p>Yakında yeni fırsatlar burada olacak!</p>
        </div>
    }
</div>

@section Scripts {
<script>
function copyCode(code) {
    navigator.clipboard.writeText(code);
    alert('Kupon kodu kopyalandı: ' + code);
}
</script>
}
