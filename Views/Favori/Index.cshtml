@model IEnumerable<art_galeri.Models.Favori>
@{ViewData["Title"] = "Favorilerim";}

<div class="dashboard-container">
    <div class="dashboard-welcome">
        <h2><i class="bi bi-heart-fill"></i> Favorilerim</h2>
        <p>Beğendiğiniz eserlerin listesi.</p>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var f in Model)
            {
                <div class="col-xl-3 col-lg-4 col-md-6">
                    <div class="artwork-card">
                        <div class="card-img-wrapper">
                            @if (!string.IsNullOrEmpty(f.Artwork?.ImageUrl))
                            { <img src="@f.Artwork.ImageUrl" class="card-img-top" alt="@f.Artwork.Title"> }
                            else
                            { <div style="height:220px;background:var(--bg-gradient);display:flex;align-items:center;justify-content:center;font-size:3rem;">🎨</div> }
                        </div>
                        <div class="card-body">
                            <h6 class="card-title">@f.Artwork?.Title</h6>
                            <p class="small text-muted">@(f.Artwork?.Artist?.Ad) @(f.Artwork?.Artist?.Soyad)</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="fw-bold text-success">@f.Artwork?.Price.ToString("N0") ₺</span>
                                <div class="d-flex gap-1">
                                    <a href="/Artwork/Detay/@f.ArtworkID" class="btn btn-sm btn-gold">Detay</a>
                                    <form action="/Favori/Cikar" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="artworkId" value="@f.ArtworkID">
                                        <button class="btn btn-sm btn-outline-danger" title="Kaldır"><i class="bi bi-trash"></i></button>
                                    </form>
                                </div>
                            </div>
                            <small class="text-muted">Eklendi: @f.EklenmeTarihi.ToLocalTime().ToString("dd.MM.yyyy")</small>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-icon">❤️</div>
            <h4>Henüz favori eklemediniz</h4>
            <p>Eserleri inceleyin ve beğendiklerinizi favorilere ekleyin.</p>
            <a href="/Artwork" class="btn btn-primary-custom mt-2">Eserleri Keşfet</a>
        </div>
    }
</div>
