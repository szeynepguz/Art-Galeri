@model art_galeri.Models.LoginViewModel

@{
    ViewData["Title"] = "Giris Yap";
}

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <h2><i class="bi bi-box-arrow-in-right"></i> Giris Yap</h2>
            <p>Hesabiniza giris yapin ve sanat dunyasini kesfedin</p>
        </div>

        <div class="auth-body">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-custom alert-success mb-3">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>@TempData["SuccessMessage"]</span>
                </div>
            }

            @if (!ViewData.ModelState.IsValid)
            {
                var errorMessages = ViewData.ModelState.Values
                    .SelectMany(v => v.Errors)
                    .Select(e => e.ErrorMessage)
                    .Where(m => !string.IsNullOrEmpty(m))
                    .ToList();

                if (errorMessages.Any())
                {
                    <div class="alert alert-custom alert-danger mb-3">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <div>
                            @foreach (var error in errorMessages)
                            {
                                <div>@error</div>
                            }
                        </div>
                    </div>
                }
            }

            <form asp-action="Login" method="post" id="loginForm" novalidate>
                @Html.AntiForgeryToken()

                <!-- E-Posta -->
                <div class="form-floating mb-3">
                    <input asp-for="Email" class="form-control" id="inputEmail" placeholder="E-Posta" type="email" autofocus />
                    <label for="inputEmail"><i class="bi bi-envelope"></i> E-Posta</label>
                    <span asp-validation-for="Email" class="field-validation-error"></span>
                </div>

                <!-- Sifre -->
                <div class="form-floating mb-3 position-relative">
                    <input asp-for="Sifre" class="form-control" id="inputSifre" placeholder="Sifre" type="password" />
                    <label for="inputSifre"><i class="bi bi-lock"></i> Sifre</label>
                    <span asp-validation-for="Sifre" class="field-validation-error"></span>
                </div>

                <!-- Giris Yap Butonu -->
                <div class="d-grid mt-4">
                    <button type="submit" class="btn btn-primary-custom btn-lg" id="btnLogin">
                        <i class="bi bi-box-arrow-in-right"></i> Giris Yap
                    </button>
                </div>
            </form>

            <div class="divider">veya</div>

            <div class="text-center">
                <span class="text-muted">Hesabiniz yok mu?</span>
                <a href="/Users/Register" class="auth-link ms-1">Hemen Kayit Olun</a>
            </div>

            <!-- Guvenlk Notu -->
            <div class="mt-4 text-center">
                <small class="text-muted">
                    <i class="bi bi-shield-lock"></i>
                    Bilgileriniz guvenli bir sekilde saklanmaktadir.
                </small>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Form submit loading
            document.getElementById('loginForm').addEventListener('submit', function () {
                const btn = document.getElementById('btnLogin');
                btn.classList.add('btn-loading');
                btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Giris yapiliyor...';
            });
        });
    </script>
}