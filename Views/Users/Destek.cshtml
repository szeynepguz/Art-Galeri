@model art_galeri.Models.DestekTalebi
@{ViewData["Title"] = "Destek";}

<div class="auth-container" style="min-height:auto;padding:2rem 0;">
    <div class="auth-card" style="max-width:600px;">
        <div class="auth-header">
            <h2><i class="bi bi-headset"></i> Müşteri Desteği</h2>
            <p>Sorularınızı bize iletebilirsiniz, en kısa sürede yanıt vereceğiz.</p>
        </div>
        <div class="auth-body">
            <form asp-action="Destek" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label fw-semibold">E-posta</label>
                    <input type="email" name="Email" class="form-control" value="@Model.Email" required>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Konu</label>
                    <input type="text" name="Konu" class="form-control" placeholder="Destek konusunu yazın..." required>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Mesajınız</label>
                    <textarea name="Mesaj" class="form-control" rows="5" placeholder="Sorunuzu veya talebinizi detaylı açıklayın..." required></textarea>
                </div>
                <button type="submit" class="btn btn-primary-custom w-100"><i class="bi bi-send me-1"></i>Gönder</button>
            </form>
            <div class="mt-4 text-center">
                <small class="text-muted">
                    <i class="bi bi-clock me-1"></i>Ortalama yanıt süresi: 24 saat &nbsp;|&nbsp;
                    <i class="bi bi-envelope me-1"></i>destek@artgaleri.com
                </small>
            </div>
        </div>
    </div>

    @if (ViewBag.Taleplerim != null)
    {
        var talepler = ViewBag.Taleplerim as List<art_galeri.Models.DestekTalebi>;
        if (talepler != null && talepler.Any())
        {
            <div class="auth-card mt-4" style="max-width:800px; margin: 0 auto;">
                <div class="auth-header">
                    <h4><i class="bi bi-list-check"></i> Geçmiş Destek Taleplerim</h4>
                </div>
                <div class="auth-body">
                    <div class="accordion" id="taleplerAccordion">
                        @foreach (var t in talepler)
                        {
                            <div class="accordion-item mb-3 border rounded shadow-sm">
                                <h2 class="accordion-header" id="heading_@t.TalepID">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse_@t.TalepID">
                                        <div class="d-flex w-100 justify-content-between align-items-center me-3">
                                            <strong>@t.Konu</strong>
                                            <span class="badge-status @(t.Durum == "Acik" ? "beklemede" : (t.Durum == "Cevaplandi" ? "onaylandi" : "iptal"))">@t.Durum</span>
                                        </div>
                                    </button>
                                </h2>
                                <div id="collapse_@t.TalepID" class="accordion-collapse collapse" data-bs-parent="#taleplerAccordion">
                                    <div class="accordion-body">
                                        <p class="mb-2"><strong>Mesajım:</strong></p>
                                        <p class="text-muted">@t.Mesaj</p>
                                        <small class="text-secondary">Tarih: @t.OlusturulmaTarihi.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</small>

                                        @if (!string.IsNullOrEmpty(t.YoneticiYaniti))
                                        {
                                            <hr />
                                            <div class="p-3 bg-light border rounded">
                                                <p class="mb-1 text-success"><strong><i class="bi bi-reply-fill"></i> Yönetici Yanıtı:</strong></p>
                                                <p class="mb-1">@t.YoneticiYaniti</p>
                                                <small class="text-secondary">Yanıt Tarihi: @t.YanitTarihi?.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</small>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>
