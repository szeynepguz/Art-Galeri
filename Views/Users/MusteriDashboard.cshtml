@model IEnumerable<art_galeri.Models.Artwork>
@{ViewData["Title"] = "Müşteri Paneli";}

<div class="dashboard-container">
    <div class="dashboard-welcome">
        <h2><i class="bi bi-person-heart"></i> Hoş Geldiniz, @ViewBag.UserName!</h2>
        <p>Eserleri inceleyin, atölyelere katılın ve sanat dünyasını keşfedin.</p>
        <div class="d-flex gap-2 mt-3 flex-wrap">
            <a href="/Artwork" class="btn btn-gold"><i class="bi bi-images me-1"></i>Eserleri Gör</a>
            <a href="/Etkinlik" class="btn btn-outline-gold"><i class="bi bi-calendar-event me-1"></i>Etkinlikler</a>
            <a href="/Favori" class="btn btn-outline-gold"><i class="bi bi-heart me-1"></i>Favorilerim</a>
        </div>
    </div>

    <!-- Kampanyalar -->
    @if (ViewBag.Kampanyalar != null)
    {
        var kamp = ViewBag.Kampanyalar as List<art_galeri.Models.Kampanya>;
        if (kamp != null && kamp.Any())
        {
            <div class="alert-custom alert-warning mb-4">
                <i class="bi bi-tag-fill"></i>
                <span>🎉 Aktif Kampanya: <strong>@kamp.First().Ad</strong> — Kupon: <code>@kamp.First().KuponKodu</code> (%@kamp.First().IndirimOrani indirim)</span>
            </div>
        }
    }

    <!-- Öne çıkan eserler -->
    <div class="section-header">
        <h4 class="section-title">🎨 Öne Çıkan Eserler</h4>
        <a href="/Artwork" class="btn btn-sm btn-outline-secondary">Tümünü Gör</a>
    </div>
    @if (Model != null && Model.Any())
    {
        <div class="row g-4 mb-4">
            @foreach (var item in Model.Take(8))
            {
                <div class="col-xl-3 col-lg-4 col-md-6">
                    <div class="artwork-card">
                        <div class="card-img-wrapper">
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            { <img src="@item.ImageUrl" class="card-img-top" alt="@item.Title"> }
                            else
                            { <div style="height:220px;background:var(--bg-gradient);display:flex;align-items:center;justify-content:center;font-size:3.5rem;">🎨</div> }
                            <div class="card-img-overlay-custom">
                                <a href="/Artwork/Detay/@item.ArtworkID" class="btn btn-sm btn-gold">Detay</a>
                            </div>
                        </div>
                        <div class="card-body">
                            <h6 class="card-title">@item.Title</h6>
                            <div class="artwork-stats">
                                <span><i class="bi bi-heart"></i> @item.BegeniSayisi</span>
                                <span><i class="bi bi-eye"></i> @item.GoruntulenmeSayisi</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <span class="fw-bold text-success">@item.Price.ToString("N0") ₺</span>
                                <a href="/Artwork/Detay/@item.ArtworkID" class="btn btn-sm btn-outline-dark">İncele</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Yaklaşan Etkinlikler -->
    @if (ViewBag.Etkinlikler != null)
    {
        var etkinlikler = ViewBag.Etkinlikler as List<art_galeri.Models.Etkinlik>;
        if (etkinlikler != null && etkinlikler.Any())
        {
            <div class="section-header mt-4">
                <h4 class="section-title">📅 Yaklaşan Etkinlikler</h4>
                <a href="/Etkinlik" class="btn btn-sm btn-outline-secondary">Tümünü Gör</a>
            </div>
            <div class="row g-3">
                @foreach (var e in etkinlikler)
                {
                    <div class="col-lg-3 col-md-6">
                        <div class="event-card">
                            <div class="p-3">
                                <h6 class="fw-bold">@e.Ad</h6>
                                <div class="small text-muted mb-2">
                                    <i class="bi bi-calendar3 me-1"></i>@e.Tarih.ToString("dd MMM", new System.Globalization.CultureInfo("tr-TR"))
                                    &nbsp;|&nbsp; <i class="bi bi-geo-alt me-1"></i>@e.Konum
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="fw-bold text-success">@e.Ucret.ToString("N0") ₺</span>
                                    <a href="/Etkinlik/Detay/@e.EtkinlikID" class="btn btn-sm btn-accent">Rezerve Et</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>
