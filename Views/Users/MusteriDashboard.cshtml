@model IEnumerable<art_galeri.Models.Artwork>
@{ViewData["Title"] = "Müşteri Paneli";}

<div class="dashboard-container">
    <div class="dashboard-welcome">
        <h2><i class="bi bi-person-heart"></i> Hoş Geldiniz, @ViewBag.UserName!</h2>
        <p>Eserleri inceleyin, atölyelere katılın ve sanat dünyasını keşfedin.</p>
        <div class="d-flex gap-2 mt-3 flex-wrap">
            <a href="/Artwork" class="btn btn-gold"><i class="bi bi-images me-1"></i>Eserleri Gör</a>
            <a href="/Etkinlik" class="btn btn-outline-gold"><i class="bi bi-calendar-event me-1"></i>Etkinlikler</a>
            <a href="/Favori" class="btn btn-outline-gold"><i class="bi bi-heart me-1"></i>Favorilerim</a>
            
            <div class="dropdown">
                <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                    <i class="bi bi-arrow-left-right me-1"></i>Kayıtlı Karşılaştırmalarım
                </button>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item" href="/Artwork/Karsilastir?ids="><i class="bi bi-palette me-2"></i>Eser Karşılaştırmaları</a></li>
                    <li><a class="dropdown-item" href="/Etkinlik/Karsilastir?ids="><i class="bi bi-calendar-event me-2"></i>Etkinlik Karşılaştırmaları</a></li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Kampanyalar -->
    @if (ViewBag.Kampanyalar != null)
    {
        var kamp = ViewBag.Kampanyalar as List<art_galeri.Models.Kampanya>;
        if (kamp != null && kamp.Any())
        {
            <div class="alert-custom alert-warning mb-4">
                <i class="bi bi-tag-fill"></i>
                <span>🎉 Aktif Kampanya: <strong>@kamp.First().Ad</strong> — Kupon: <code>@kamp.First().KuponKodu</code> (%@kamp.First().IndirimOrani indirim)</span>
            </div>
        }
    }

    <!-- Öne çıkan eserler -->
    <div class="section-header d-flex justify-content-between align-items-center mb-3">
        <div class="d-flex align-items-center gap-3">
            <h4 class="section-title mb-0">🎨 Öne Çıkan Eserler</h4>
            <button id="btnCompareArtwork" class="btn btn-sm btn-gold d-none" onclick="goCompareArtwork()"><i class="bi bi-arrow-left-right"></i> Karşılaştır (<span id="compareArtworkCount">0</span>)</button>
        </div>
        <a href="/Artwork" class="btn btn-sm btn-outline-secondary">Tümünü Gör</a>
    </div>
    @if (Model != null && Model.Any())
    {
        <div class="row g-4 mb-4">
            @foreach (var item in Model.Take(8))
            {
                <div class="col-xl-3 col-lg-4 col-md-6">
                    <div class="artwork-card h-100 d-flex flex-column">
                        <div class="card-img-wrapper">
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            { <img src="@item.ImageUrl" class="card-img-top" alt="@item.Title"> }
                            else
                            { <div style="height:220px;background:var(--bg-gradient);display:flex;align-items:center;justify-content:center;font-size:3.5rem;">🎨</div> }
                            <div class="card-img-overlay-custom">
                                <a href="/Artwork/Detay/@item.ArtworkID" class="btn btn-sm btn-gold">Detay</a>
                            </div>
                        </div>
                        <div class="card-body">
                            <h6 class="card-title">@item.Title</h6>
                            <div class="artwork-stats">
                                <span><i class="bi bi-heart"></i> @item.BegeniSayisi</span>
                                <span><i class="bi bi-eye"></i> @item.GoruntulenmeSayisi</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <span class="fw-bold text-success">@item.Price.ToString("N0") ₺</span>
                                <a href="/Artwork/Detay/@item.ArtworkID" class="btn btn-sm btn-outline-dark">İncele</a>
                            </div>
                        </div>
                        <div class="card-footer bg-light border-top p-2 text-center" style="margin-top:auto;">
                            <div class="form-check form-switch d-inline-block mb-0">
                                <input class="form-check-input compare-artwork-check border-secondary" type="checkbox" role="switch" value="@item.ArtworkID" id="chk-art-@item.ArtworkID" onchange="updateCompareArtwork()" style="cursor:pointer; transform: scale(1.2); margin-top:0.25rem;">
                                <label class="form-check-label fw-bold text-dark ms-1" for="chk-art-@item.ArtworkID" style="cursor:pointer; font-size:0.9rem;"><i class="bi bi-plus-circle"></i> Karşılaştırmaya Ekle</label>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Yaklaşan Etkinlikler -->
    @if (ViewBag.Etkinlikler != null)
    {
        var etkinlikler = ViewBag.Etkinlikler as List<art_galeri.Models.Etkinlik>;
        if (etkinlikler != null && etkinlikler.Any())
        {
            <div class="section-header mt-4 d-flex justify-content-between align-items-center mb-3">
                <div class="d-flex align-items-center gap-3">
                    <h4 class="section-title mb-0">📅 Yaklaşan Etkinlikler</h4>
                    <button id="btnCompareEvent" class="btn btn-sm btn-gold d-none" onclick="goCompareEvent()"><i class="bi bi-arrow-left-right"></i> Karşılaştır (<span id="compareEventCount">0</span>)</button>
                </div>
                <a href="/Etkinlik" class="btn btn-sm btn-outline-secondary">Tümünü Gör</a>
            </div>
            <div class="row g-3">
                @foreach (var e in etkinlikler)
                {
                    <div class="col-lg-3 col-md-6">
                        <div class="event-card h-100 d-flex flex-column">
                            <div class="p-3">
                                <h6 class="fw-bold">@e.Ad</h6>
                                <div class="small text-muted mb-2">
                                    <i class="bi bi-calendar3 me-1"></i>@e.Tarih.ToString("dd MMM", new System.Globalization.CultureInfo("tr-TR"))
                                    &nbsp;|&nbsp; <i class="bi bi-geo-alt me-1"></i>@e.Konum
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="fw-bold text-success">@e.Ucret.ToString("N0") ₺</span>
                                    <a href="/Etkinlik/Detay/@e.EtkinlikID" class="btn btn-sm btn-accent">Rezerve Et</a>
                                </div>
                            </div>
                            <div class="card-footer bg-light border-top p-2 text-center" style="margin-top:auto;">
                                <div class="form-check form-switch d-inline-block mb-0">
                                    <input class="form-check-input compare-event-check border-secondary" type="checkbox" role="switch" value="@e.EtkinlikID" id="chk-evt-@e.EtkinlikID" onchange="updateCompareEvent()" style="cursor:pointer; transform: scale(1.2); margin-top:0.25rem;">
                                    <label class="form-check-label fw-bold text-dark ms-1" for="chk-evt-@e.EtkinlikID" style="cursor:pointer; font-size:0.9rem;"><i class="bi bi-plus-circle"></i> Karşılaştırmaya Ekle</label>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

@section Scripts {
<script>
function updateCompareArtwork() {
    const checked = document.querySelectorAll('.compare-artwork-check:checked');
    const btn = document.getElementById('btnCompareArtwork');
    const count = document.getElementById('compareArtworkCount');
    
    if (checked.length > 0) {
        btn.classList.remove('d-none');
        count.textContent = checked.length;
    } else {
        btn.classList.add('d-none');
    }
}

function goCompareArtwork() {
    const checked = document.querySelectorAll('.compare-artwork-check:checked');
    const ids = Array.from(checked).map(c => c.value).join(',');
    window.location.href = '/Artwork/Karsilastir?ids=' + ids;
}

function updateCompareEvent() {
    const checked = document.querySelectorAll('.compare-event-check:checked');
    const btn = document.getElementById('btnCompareEvent');
    const count = document.getElementById('compareEventCount');
    
    if (checked.length > 0) {
        btn.classList.remove('d-none');
        count.textContent = checked.length;
    } else {
        btn.classList.add('d-none');
    }
}

function goCompareEvent() {
    const checked = document.querySelectorAll('.compare-event-check:checked');
    const ids = Array.from(checked).map(c => c.value).join(',');
    window.location.href = '/Etkinlik/Karsilastir?ids=' + ids;
}
</script>
}
