@model IEnumerable<art_galeri.Models.Artwork>

@{
    ViewData["Title"] = "Musteri Paneli";
}

<div class="dashboard-container">
    <!-- Hosgeldin Banneri -->
    <div class="dashboard-welcome">
        <h2><i class="bi bi-heart-fill"></i> Hos Geldiniz, @ViewBag.UserName!</h2>
        <p>Eserleri inceleyin, favorilerinize ekleyin ve sanat dunyasini kesfedin.</p>
    </div>

    <!-- Eserler -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold"><i class="bi bi-grid-3x3-gap"></i> Eserler</h4>
        <span class="badge bg-dark px-3 py-2">@(Model?.Count() ?? 0) Eser</span>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="artwork-card">
                        <div class="card-img-wrapper">
                            <img src="@item.ImageUrl" class="card-img-top" alt="@item.Title">
                            <div class="card-img-overlay-custom">
                                <button class="btn btn-sm btn-gold">
                                    <i class="bi bi-heart"></i> Favori
                                </button>
                            </div>
                        </div>
                        <div class="card-body p-3">
                            <h5 class="card-title fw-bold">@item.Title</h5>
                            <p class="card-text text-muted small">@item.Description</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-success fw-bold fs-5">@item.Price.ToString("C2")</span>
                                <button class="btn btn-outline-dark btn-sm">
                                    <i class="bi bi-eye"></i> Detay
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-icon">🎨</div>
            <h4>Henuz eser bulunmamaktadir</h4>
            <p>Sanatcilar eserlerini yukledikce burada gorunecektir.</p>
        </div>
    }

    <!-- Giris yapmamis kullanicilar icin yorum uyarisi -->
    @if (Context.Session.GetInt32("UserID") == null)
    {
        <div class="alert alert-custom alert-warning mt-4">
            <i class="bi bi-info-circle-fill"></i>
            <span>Yorum yapmak ve favori eklemek icin <a href="/Users/Login" class="auth-link">giris yapin</a>.</span>
        </div>
    }
</div>
