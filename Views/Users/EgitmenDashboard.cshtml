@model IEnumerable<art_galeri.Models.Etkinlik>
@{ViewData["Title"] = "Eğitmen Paneli";}

<div class="dashboard-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="dashboard-welcome">
            <h2><i class="bi bi-mortarboard"></i> Eğitmen Paneli</h2>
            <p>Hoş geldiniz @ViewBag.UserName! Etkinliklerinizin özeti aşağıda.</p>
        </div>
        <a asp-controller="Etkinlik" asp-action="Olustur" class="btn btn-accent px-4 py-2 shadow-sm"><i class="bi bi-plus-circle"></i> Yeni Etkinlik</a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="stat-card gold"><div class="stat-icon">📅</div><div class="stat-number">@ViewBag.ToplamEtkinlik</div><div class="stat-label">Toplam Etkinlik</div></div>
        </div>
        <div class="col-md-4">
            <div class="stat-card success"><div class="stat-icon">👥</div><div class="stat-number">@ViewBag.ToplamRezervasyonlar</div><div class="stat-label">Toplam Katılımcı</div></div>
        </div>
        <div class="col-md-4">
            <div class="stat-card accent"><div class="stat-icon">⭐</div><div class="stat-number">@(((double)ViewBag.OrtalamaPuan).ToString("F1"))</div><div class="stat-label">Ortalama Puan</div></div>
        </div>
    </div>

    <div class="panel-card">
        <div class="panel-title"><i class="bi bi-calendar-event"></i> Etkinliklerim</div>
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-custom">
                    <thead><tr><th>Etkinlik</th><th>Tarih</th><th>Doluluk</th><th>Ort. Puan</th><th>Ücret</th><th class="text-end">İşlemler</th></tr></thead>
                    <tbody>
                        @foreach (var e in Model)
                        {
                            var d = (int)e.DolulukOrani;
                            <tr>
                                <td>
                                    <strong>@e.Ad</strong>
                                    @if(!e.Aktif){ <span class="badge bg-secondary ms-2">Pasif</span> }
                                </td>
                                <td>@e.Tarih.ToString("dd.MM.yyyy")</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress-bar-custom" style="width:80px;"><div class="progress-fill @(d>=90?"dolu":"")" style="width:@d%"></div></div>
                                        <span>@e.RezervasyonSayisi/@e.Kapasite</span>
                                    </div>
                                </td>
                                <td><span class="stars">@for(int i=1;i<=5;i++){@(i<=Math.Round(e.OrtalamaPuan)?"⭐":"☆")}</span> @e.OrtalamaPuan.ToString("F1")</td>
                                <td class="fw-bold text-success">@e.Ucret.ToString("N0") ₺</td>
                                <td class="text-end">
                                    <div class="btn-group">
                                        <a asp-controller="Etkinlik" asp-action="Duzenle" asp-route-id="@e.EtkinlikID" class="btn btn-sm btn-outline-gold" title="Düzenle"><i class="bi bi-pencil"></i></a>
                                        <form asp-controller="Etkinlik" asp-action="Sil" asp-route-id="@e.EtkinlikID" method="post" style="display:inline;" onsubmit="return confirm('Bu etkinliği silmek istediğinize emin misiniz?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger ms-1" title="Sil"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon">📅</div>
                <h4>Henüz etkinliğiniz yok</h4>
                <p>Hemen ilk etkinliğinizi oluşturun!</p>
                <a asp-controller="Etkinlik" asp-action="Olustur" class="btn btn-accent mt-2">Etkinlik Oluştur</a>
            </div>
        }
    </div>

    <!-- Yorumlar Yönetimi -->
    <div class="panel-card mt-4">
        <div class="panel-title"><i class="bi bi-chat-right-text"></i> Etkinlik Yorumları</div>
        @if (ViewBag.EtkinlikYorumlari != null)
        {
            var yorumlar = ViewBag.EtkinlikYorumlari as List<art_galeri.Models.Yorum>;
            if (yorumlar != null && yorumlar.Any())
            {
                <div class="table-responsive">
                    <table class="table table-custom">
                        <thead>
                            <tr>
                                <th>Kullanıcı</th>
                                <th>Etkinlik</th>
                                <th>Puan</th>
                                <th>Yorum</th>
                                <th>Tarih</th>
                                <th>Durum</th>
                                <th>Yanıtla</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var y in yorumlar)
                            {
                                <tr>
                                    <td><strong>@y.User?.Ad @y.User?.Soyad</strong><br><small class="text-muted">@y.User?.Email</small></td>
                                    <td>@y.Etkinlik?.Ad</td>
                                    <td><span class="stars">@for (int i = 1; i <= 5; i++) { @(i <= y.Puan ? "⭐" : "☆") }</span></td>
                                    <td><p class="mb-1 small">@y.Icerik</p></td>
                                    <td>@y.OlusturulmaTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(y.YoneticiYaniti))
                                        {
                                            <span class="badge bg-success">Yanıtlandı</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">Bekliyor</span>
                                        }
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-gold" type="button" data-bs-toggle="collapse" data-bs-target="#reply-@y.YorumID">
                                            Yanıtla
                                        </button>
                                    </td>
                                </tr>
                                <tr class="collapse" id="reply-@y.YorumID">
                                    <td colspan="7" class="bg-light p-3">
                                        <form asp-controller="Yorum" asp-action="YoneticiYanit" method="post" class="d-flex gap-2">
                                            <input type="hidden" name="yorumId" value="@y.YorumID" />
                                            <input type="hidden" name="donusUrl" value="/Users/EgitmenDashboard" />
                                            <input type="text" name="yanit" class="form-control form-control-sm" placeholder="Yanıtlınızı buraya yazın..." value="@y.YoneticiYaniti" required />
                                            <button type="submit" class="btn btn-sm btn-gold">Gönder</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted text-center py-3">Henüz etkinliklerinize yapılmış bir yorum bulunmuyor.</p>
            }
        }
    </div>
</div>
