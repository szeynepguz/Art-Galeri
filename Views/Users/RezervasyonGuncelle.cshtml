@model art_galeri.Models.Rezervasyon
@{ViewData["Title"] = "Rezervasyon Güncelle";}
@{var digerTarihler = ViewBag.DigerTarihler as List<art_galeri.Models.EtkinlikTarih> ?? new List<art_galeri.Models.EtkinlikTarih>();}

<div class="auth-container">
    <div class="auth-card" style="max-width:600px;">
        <div class="auth-header">
            <h2><i class="bi bi-pencil-square"></i> Rezervasyon Güncelle</h2>
            <p>@Model.Etkinlik?.Ad</p>
        </div>
        <div class="auth-body">
            <!-- Mevcut Bilgiler -->
            <div class="panel-card mb-3" style="background:#f0fdf4;">
                <div class="row text-center">
                    <div class="col-4">
                        <div class="small text-muted">Mevcut Tarih</div>
                        @if (Model.EtkinlikTarih != null)
                        {
                            <strong>@Model.EtkinlikTarih.Tarih.ToString("dd MMM yyyy", new System.Globalization.CultureInfo("tr-TR"))</strong>
                            <div class="small text-muted">@Model.EtkinlikTarih.Saat.ToString(@"hh\:mm")</div>
                        }
                        else
                        {
                            <strong>@Model.Etkinlik?.Tarih.ToString("dd MMM yyyy", new System.Globalization.CultureInfo("tr-TR"))</strong>
                        }
                    </div>
                    <div class="col-4">
                        <div class="small text-muted">Ücret/Kişi</div>
                        <strong class="text-success">@Model.Etkinlik?.Ucret.ToString("N0") ₺</strong>
                    </div>
                    <div class="col-4">
                        <div class="small text-muted">Konum</div>
                        <strong>@Model.Etkinlik?.Konum</strong>
                    </div>
                </div>
            </div>

            <div class="panel-card mb-3" style="background:#f8f9fa;">
                <div class="row text-center">
                    <div class="col-6">
                        <div class="small text-muted">Mevcut Katılımcı</div>
                        <strong class="text-primary">@Model.KatilimciSayisi kişi</strong>
                    </div>
                    <div class="col-6">
                        <div class="small text-muted">Mevcut Tutar</div>
                        <strong class="text-success">@Model.ToplamTutar.ToString("N0") ₺</strong>
                    </div>
                </div>
            </div>

            <form asp-controller="Users" asp-action="RezervasyonGuncelle" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.RezervasyonID">

                <!-- Tarih Değiştirme -->
                <div class="mb-3">
                    <label class="form-label fw-semibold"><i class="bi bi-calendar-range me-1"></i>Etkinlik Tarihini Değiştir</label>
                    @if (digerTarihler.Any())
                    {
                        <div class="row g-2">
                            @if (Model.EtkinlikTarihID != null)
                            {
                                <div class="col-12">
                                    <input type="radio" class="btn-check" name="yeniTarihId" value="@Model.EtkinlikTarihID" id="tarih-mevcut" checked>
                                    <label class="btn btn-outline-success w-100 text-start p-3 d-flex justify-content-between align-items-center" for="tarih-mevcut" style="border-width: 1.5px;" data-ucret="@Model.Etkinlik?.Ucret">
                                        <div>
                                            <i class="bi bi-calendar-check me-2"></i>
                                            <strong>@Model.EtkinlikTarih?.Tarih.ToString("dd MMMM yyyy, dddd", new System.Globalization.CultureInfo("tr-TR"))</strong>
                                            <span class="badge bg-success ms-2" style="font-size:.65rem;">Mevcut</span>
                                        </div>
                                        <small class="text-muted">@Model.EtkinlikTarih?.Saat.ToString(@"hh\:mm")</small>
                                    </label>
                                </div>
                            }
                            @foreach (var t in digerTarihler)
                            {
                                var tDoluluk = (int)t.DolulukOrani;
                                <div class="col-12">
                                    <input type="radio" class="btn-check" name="yeniTarihId" value="@t.EtkinlikTarihID" id="tarih-@t.EtkinlikTarihID" 
                                           @(Model.EtkinlikTarihID == null && digerTarihler.IndexOf(t) == 0 ? "checked" : "")>
                                    <label class="btn btn-outline-secondary w-100 text-start p-3 d-flex justify-content-between align-items-center" for="tarih-@t.EtkinlikTarihID" style="border-width: 1.5px;" data-ucret="@Model.Etkinlik?.Ucret">
                                        <div>
                                            <i class="bi bi-calendar-event me-2 text-primary"></i>
                                            <strong>@t.Tarih.ToString("dd MMMM yyyy, dddd", new System.Globalization.CultureInfo("tr-TR"))</strong>
                                            <span class="text-muted ms-2"><i class="bi bi-clock me-1"></i>@t.Saat.ToString(@"hh\:mm")</span>
                                        </div>
                                        <div class="text-end">
                                            <div class="small @(tDoluluk >= 80 ? "text-danger" : "text-success")">
                                                @t.KalanKapasite kişilik yer
                                            </div>
                                            <div class="progress-bar-custom" style="width:80px;height:4px;">
                                                <div class="progress-fill @(tDoluluk>=90?"dolu":"")" style="width:@tDoluluk%"></div>
                                            </div>
                                        </div>
                                    </label>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert-custom alert-info">
                            <i class="bi bi-info-circle me-1"></i> Bu etkinlik için başka müsait tarih bulunmuyor.
                        </div>
                    }
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Yeni Katılımcı Sayısı</label>
                    <input type="number" name="katilimciSayisi" class="form-control" min="1" 
                           value="@Model.KatilimciSayisi" id="kisiSayisi">
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Notlar</label>
                    <textarea name="notlar" class="form-control" rows="2" placeholder="Özel talepleriniz...">@Model.Notlar</textarea>
                </div>

                <div class="panel-card mb-3" style="background:#fff3cd;">
                    <strong>Yeni Toplam: </strong>
                    <span id="yeniToplam" class="text-success fw-bold">@Model.ToplamTutar.ToString("N0") ₺</span>
                </div>

                <button type="submit" class="btn btn-primary-custom w-100">
                    <i class="bi bi-check-circle me-1"></i>Güncelle
                </button>
                <a href="/Users/Rezervasyonlarim" class="btn btn-outline-secondary w-100 mt-2">Geri Dön</a>
            </form>

            <hr>
            <form asp-action="RezervasyonIptal" method="post" onsubmit="return confirm('Rezervasyonu iptal etmek istediğinizden emin misiniz?')">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.RezervasyonID">
                <button type="submit" class="btn btn-outline-danger w-100">
                    <i class="bi bi-x-circle me-1"></i>Rezervasyonu İptal Et
                </button>
            </form>
        </div>
    </div>
</div>

<style>
.btn-check:checked + .btn-outline-secondary { background-color: #6c757d !important; color: white !important; border-color: #6c757d !important; }
.btn-check:checked + .btn-outline-secondary i { color: white !important; }
.btn-check:checked + .btn-outline-secondary .text-primary { color: white !important; }
.btn-check:checked + .btn-outline-secondary .text-muted { color: rgba(255,255,255,.8) !important; }
.btn-check:checked + .btn-outline-secondary .text-success { color: #a7f3d0 !important; }
.btn-check:checked + .btn-outline-secondary .text-danger { color: #fca5a5 !important; }
.btn-check:checked + .btn-outline-success { background-color: #10b981 !important; color: white !important; border-color: #10b981 !important; }
.btn-check:checked + .btn-outline-success .text-muted { color: rgba(255,255,255,.8) !important; }
</style>

@section Scripts {
<script>
const ucret = parseFloat('@(Model.Etkinlik?.Ucret.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0")');

function hesapla() {
    const kisi = parseInt(document.getElementById('kisiSayisi').value) || 1;
    const toplam = ucret * kisi;
    document.getElementById('yeniToplam').textContent = toplam.toLocaleString('tr-TR') + ' ₺';
}

document.getElementById('kisiSayisi').addEventListener('input', hesapla);
</script>
}
