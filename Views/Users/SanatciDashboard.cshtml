@model IEnumerable<art_galeri.Models.Artwork>
@{ViewData["Title"] = "Sanatçı Paneli";}

<div class="dashboard-container">
    <div class="dashboard-welcome">
        <h2><i class="bi bi-easel"></i> Sanatçı Paneli</h2>
        <p>Hoş geldiniz @ViewBag.UserName! Eserlerinizin performansını takip edin.</p>
        <a href="/Artwork/Yukle" class="btn btn-gold mt-2"><i class="bi bi-cloud-upload me-1"></i>Yeni Eser Yükle</a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3"><div class="stat-card gold"><div class="stat-icon">🎨</div><div class="stat-number">@ViewBag.ToplamEser</div><div class="stat-label">Toplam Eser</div></div></div>
        <div class="col-md-3"><div class="stat-card info"><div class="stat-icon">👁️</div><div class="stat-number">@ViewBag.ToplamGoruntulenme</div><div class="stat-label">Görüntülenme</div></div></div>
        <div class="col-md-3"><div class="stat-card accent"><div class="stat-icon">❤️</div><div class="stat-number">@ViewBag.ToplamBegeni</div><div class="stat-label">Beğeni</div></div></div>
        <div class="col-md-3"><div class="stat-card success"><div class="stat-icon">💬</div><div class="stat-number">@ViewBag.ToplamYorum</div><div class="stat-label">Yorum</div></div></div>
    </div>

    <div class="panel-card">
        <div class="panel-title"><i class="bi bi-images"></i> Eserlerim</div>
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-custom">
                    <thead><tr><th>Eser</th><th>Kategori</th><th>Görüntülenme</th><th>Beğeni</th><th>Yorum</th><th>Fiyat</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var a in Model)
                        {
                            <tr>
                                <td><strong>@a.Title</strong></td>
                                <td>@a.Kategori</td>
                                <td><i class="bi bi-eye text-info"></i> @a.GoruntulenmeSayisi</td>
                                <td><i class="bi bi-heart text-danger"></i> @a.BegeniSayisi</td>
                                <td><i class="bi bi-chat text-success"></i> @a.YorumSayisi</td>
                                <td class="fw-bold text-success">@a.Price.ToString("N0") ₺</td>
                                <td><a href="/Artwork/Detay/@a.ArtworkID" class="btn btn-sm btn-outline-secondary">Detay</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state"><div class="empty-icon">🎨</div><h4>Henüz eser yüklemediniz</h4><a href="/Artwork/Yukle" class="btn btn-primary-custom mt-2">İlk Eserini Yükle</a></div>
        }
    </div>
</div>
