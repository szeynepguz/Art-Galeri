@model IEnumerable<art_galeri.Models.Etkinlik>
@{ViewData["Title"] = "Etkinlik Karşılaştırma";}

<div class="dashboard-container">
    <div class="dashboard-welcome mb-4">
        <h2><i class="bi bi-arrow-left-right"></i> Etkinlik Karşılaştırma</h2>
        <p>Seçtiğiniz etkinlikleri ve atölyeleri yan yana inceleyin.</p>
    </div>

    @if (Model != null && Model.Any())
    {
        <!-- Kaydet Butonu -->
        @if (Context.Session.GetInt32("UserID") != null)
        {
            <div class="panel-card mb-3 d-flex justify-content-between align-items-center">
                <div class="d-flex gap-2 align-items-center">
                    <i class="bi bi-bookmark text-accent" style="font-size:1.3rem;"></i>
                    <input type="text" id="karsilastirmaBaslik" class="form-control form-control-sm" placeholder="Karşılaştırma adı girin..." style="width:250px;" value="Etkinlik Karşılaştırma - @DateTime.Now.ToString("dd.MM.yyyy")">
                </div>
                <button class="btn btn-sm btn-gold" onclick="kaydetKarsilastirma()">
                    <i class="bi bi-save me-1"></i>Karşılaştırmayı Kaydet
                </button>
            </div>
        }

        <div class="panel-card overflow-auto">
            <table class="table table-bordered table-custom text-center align-middle">
                <thead class="table-light">
                    <tr>
                        <th style="min-width: 200px;">Özellik</th>
                        @foreach (var item in Model)
                        {
                            <th style="min-width: 250px;">
                                <div class="d-flex flex-column align-items-center">
                                    @if (!string.IsNullOrEmpty(item.GorselUrl))
                                    {
                                        <img src="@item.GorselUrl" style="width: 150px; height: 100px; object-fit: cover;" class="rounded shadow-sm mb-2">
                                    }
                                    else
                                    {
                                        <div style="width: 150px; height: 100px; background: #f8f9fa;" class="rounded shadow-sm mb-2 d-flex align-items-center justify-content-center">
                                            <span style="font-size: 2rem;">🎭</span>
                                        </div>
                                    }
                                    <h6 class="mb-0">@item.Ad</h6>
                                    <a href="/Etkinlik/Detay/@item.EtkinlikID" class="btn btn-sm btn-link text-gold">Detaylı İncele</a>
                                </div>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold">Tarih</td>
                        @{
                            var tarihler = Model.Select(m => m.Tarih).ToList();
                            var enYakinTarih = tarihler.Where(t => t >= DateTime.UtcNow).OrderBy(t => t).FirstOrDefault();
                        }
                        @foreach (var item in Model)
                        {
                            <td>
                                @item.Tarih.ToString("dd MMM yyyy", new System.Globalization.CultureInfo("tr-TR"))
                                @if (item.Tarih == enYakinTarih && item.Tarih >= DateTime.UtcNow) { <span class="badge bg-info ms-1" style="font-size:.6rem;">En Yakın</span> }
                            </td>
                        }
                    </tr>
                    <tr>
                        <td class="fw-bold">Saat</td>
                        @foreach (var item in Model)
                        {
                            <td>@item.Saat.ToString(@"hh\:mm")</td>
                        }
                    </tr>
                    <tr>
                        <td class="fw-bold">Konum</td>
                        @foreach (var item in Model)
                        {
                            <td>@item.Konum</td>
                        }
                    </tr>
                    <tr>
                        <td class="fw-bold">Eğitmen</td>
                        @foreach (var item in Model)
                        {
                            <td>@item.Egitmen?.Ad @item.Egitmen?.Soyad</td>
                        }
                    </tr>
                    <tr>
                        <td class="fw-bold">Kategori</td>
                        @foreach (var item in Model)
                        {
                            <td><span class="badge bg-light text-dark">@item.Kategori</span></td>
                        }
                    </tr>
                    <tr>
                        <td class="fw-bold">Ücret</td>
                        @{
                            var ucretler = Model.Select(m => m.Ucret).ToList();
                            var minUcret = ucretler.Min();
                        }
                        @foreach (var item in Model)
                        {
                            <td class="fw-bold @(item.Ucret == minUcret ? "text-success" : "text-dark")" style="font-size: 1.1rem;">
                                @item.Ucret.ToString("N0") ₺
                                @if (item.Ucret == minUcret && ucretler.Count(u => u == minUcret) == 1) { <span class="badge bg-success ms-1" style="font-size:.6rem;">En Uygun</span> }
                            </td>
                        }
                    </tr>
                    <tr>
                        <td class="fw-bold">Kapasite / Doluluk</td>
                        @foreach (var item in Model)
                        {
                            <td>
                                <div>@item.RezervasyonSayisi / @item.Kapasite</div>
                                <div class="progress-bar-custom mx-auto" style="width:100px;">
                                    <div class="progress-fill @(item.DolulukOrani >= 90 ? "dolu" : "")" style="width:@((int)item.DolulukOrani)%"></div>
                                </div>
                                @if (item.KalanKapasite > 0)
                                {
                                    <small class="text-success">@item.KalanKapasite yer kaldı</small>
                                }
                                else
                                {
                                    <small class="text-danger fw-bold">Dolu</small>
                                }
                            </td>
                        }
                    </tr>
                    <tr>
                        <td class="fw-bold">Değerlendirme</td>
                        @foreach (var item in Model)
                        {
                            <td>
                                <span class="stars">@for(int i=1;i<=5;i++){@(i<=Math.Round(item.OrtalamaPuan)?"⭐":"☆")}</span>
                                <div class="small text-muted">(@item.OrtalamaPuan.ToString("F1"))</div>
                            </td>
                        }
                    </tr>
                    <tr>
                        <td></td>
                        @foreach (var item in Model)
                        {
                            <td>
                                @if (item.KalanKapasite > 0)
                                {
                                    <a href="/Etkinlik/Rezervasyon?id=@item.EtkinlikID" class="btn btn-accent w-100"><i class="bi bi-calendar-check"></i> Rezerve Et</a>
                                }
                                else
                                {
                                    <button class="btn btn-danger w-100 disabled">Dolu</button>
                                }
                            </td>
                        }
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Kayıtlı Karşılaştırmalar -->
        @if (ViewBag.KayitliKarsilastirma != null)
        {
            var kayitlar = ((string)ViewBag.KayitliKarsilastirma).Split(";;;", StringSplitOptions.RemoveEmptyEntries);
            if (kayitlar.Length > 0)
            {
                <div class="panel-card mt-4">
                    <div class="panel-title"><i class="bi bi-bookmark-fill text-gold" style="color:var(--gold);"></i> Kayıtlı Karşılaştırmalarınız</div>
                    <div class="list-group">
                        @foreach (var k in kayitlar)
                        {
                            var parts = k.Split('|');
                            var baslik = parts[0];
                            var ids = parts.Length > 1 ? parts[1] : "";
                            var tarih = parts.Length > 2 ? parts[2] : "";
                            <a href="/Etkinlik/Karsilastir?ids=@ids" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>@baslik</strong>
                                    <small class="text-muted d-block">@tarih</small>
                                </div>
                                <i class="bi bi-arrow-right"></i>
                            </a>
                        }
                    </div>
                </div>
            }
        }
    }
    else
    {
        <div class="empty-state">
            <div class="empty-icon">🤷</div>
            <h4>Karşılaştırılacak etkinlik bulunamadı</h4>
            <p>Lütfen etkinlikler listesinden en az iki etkinlik seçin.</p>
            <a href="/Etkinlik" class="btn btn-gold mt-3">Etkinliklere Dön</a>
        </div>
    }
</div>

@section Scripts {
<script>
function kaydetKarsilastirma() {
    const baslik = document.getElementById('karsilastirmaBaslik').value || 'Etkinlik Karşılaştırma';
    const params = new URLSearchParams(window.location.search);
    const ids = params.get('ids') || '';

    fetch('/Etkinlik/KarsilastirmaKaydet', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: `ids=${ids}&baslik=${encodeURIComponent(baslik)}`
    })
    .then(r => r.json())
    .then(d => {
        if (d.success) {
            alert(d.message);
            location.reload();
        } else {
            alert(d.message);
        }
    });
}
</script>
}
