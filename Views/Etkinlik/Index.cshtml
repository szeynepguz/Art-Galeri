@model IEnumerable<art_galeri.Models.Etkinlik>
@{ViewData["Title"] = "Etkinlikler";}

<div class="dashboard-container">
    <div class="dashboard-welcome">
        <h2><i class="bi bi-calendar-event"></i> Etkinlikler & Atölyeler</h2>
        <p>Uzman eğitmenlerle sanata adım atın. Rezervasyonunuzu hemen oluşturun.</p>
    </div>

    <form method="get" class="panel-card mb-4">
        <div class="row g-2">
            <div class="col-md-7"><input type="text" name="arama" class="form-control" placeholder="Etkinlik ara..."></div>
            <div class="col-md-4">
                <select name="kategori" class="form-select">
                    <option value="">Tüm Kategoriler</option>
                    @foreach (var k in ViewBag.Kategoriler as List<string?> ?? new List<string?>())
                    { <option value="@k" selected="@(ViewBag.SecilenKategori == k)">@k</option> }
                </select>
            </div>
            <div class="col-md-1"><button type="submit" class="btn btn-accent w-100"><i class="bi bi-search"></i></button></div>
        </div>
    </form>

    @if (Model != null && Model.Any())
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="section-title">@Model.Count() Etkinlik</h4>
            <button id="btnCompare" class="btn btn-sm btn-gold d-none" onclick="goCompare()"><i class="bi bi-arrow-left-right"></i> Karşılaştır (<span id="compareCount">0</span>)</button>
        </div>
        <div class="row g-4">
            @foreach (var e in Model)
            {
                var doluluk = (int)e.DolulukOrani;
                <div class="col-lg-4 col-md-6">
                    <div class="event-card h-100 d-flex flex-column">
                        <div style="position:relative;">
                            @if (!string.IsNullOrEmpty(e.GorselUrl))
                            {
                                <img src="@e.GorselUrl" class="event-img" alt="@e.Ad">
                            }
                            else
                            {
                                <div class="event-img d-flex align-items-center justify-content-center" style="background:var(--bg-gradient);font-size:4rem;">🎭</div>
                            }
                            <span class="event-badge">@e.Kategori</span>
                        </div>
                        <div class="p-3">
                            <h6 class="fw-bold mb-1">@e.Ad</h6>
                            <p class="text-muted small mb-2">@e.Aciklama</p>
                            <div class="d-flex flex-column gap-1 mb-3 small text-muted">
                                @if (e.Tarihler != null && e.Tarihler.Any())
                                {
                                    <span><i class="bi bi-calendar-range me-1"></i>@e.Tarihler.Count tarih mevcut</span>
                                    <span><i class="bi bi-calendar3 me-1"></i>@e.Tarihler.OrderBy(t => t.Tarih).First().Tarih.ToString("dd MMM", new System.Globalization.CultureInfo("tr-TR")) — @e.Tarihler.OrderBy(t => t.Tarih).Last().Tarih.ToString("dd MMM yyyy", new System.Globalization.CultureInfo("tr-TR"))</span>
                                }
                                else
                                {
                                    <span><i class="bi bi-calendar3 me-1"></i>@e.Tarih.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("tr-TR"))</span>
                                }
                                <span><i class="bi bi-geo-alt me-1"></i>@e.Konum</span>
                                <span><i class="bi bi-person me-1"></i>@(e.Egitmen?.Ad) @(e.Egitmen?.Soyad)</span>
                            </div>
                            <div class="mb-2">
                                <div class="d-flex justify-content-between small mb-1">
                                    <span>Doluluk: @e.RezervasyonSayisi/@e.Kapasite</span>
                                    <span class="@(doluluk >= 90 ? "text-danger" : "text-success")">%@doluluk</span>
                                </div>
                                <div class="progress-bar-custom">
                                    <div class="progress-fill @(doluluk >= 90 ? "dolu" : "")" style="width:@doluluk%"></div>
                                </div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="fw-bold text-success">@e.Ucret.ToString("N0") ₺</span>
                                    <span class="stars ms-2" title="Ortalama puan">
                                        @for (int i = 1; i <= 5; i++) { @(i <= Math.Round(e.OrtalamaPuan) ? "⭐" : "☆") }
                                    </span>
                                </div>
                                @if (e.KalanKapasite > 0)
                                {
                                    <a href="/Etkinlik/Detay/@e.EtkinlikID" class="btn btn-sm btn-accent">Detay</a>
                                }
                                else
                                {
                                    <span class="btn btn-sm btn-danger disabled">Dolu</span>
                                }
                            </div>
                        </div>
                        <div class="card-footer bg-light border-top p-2 text-center" style="margin-top:auto;">
                            <div class="form-check form-switch d-inline-block mb-0">
                                <input class="form-check-input compare-check border-secondary" type="checkbox" role="switch" value="@e.EtkinlikID" id="chk-@e.EtkinlikID" onchange="updateCompare()" style="cursor:pointer; transform: scale(1.2); margin-top:0.25rem;">
                                <label class="form-check-label fw-bold text-dark ms-1" for="chk-@e.EtkinlikID" style="cursor:pointer; font-size:0.9rem;"><i class="bi bi-plus-circle"></i> Karşılaştırmaya Ekle</label>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state"><div class="empty-icon">📅</div><h4>Etkinlik bulunamadı</h4><p>Yakında yeni etkinlikler eklenecek.</p></div>
    }
</div>

@section Scripts {
<script>
function updateCompare() {
    const checked = document.querySelectorAll('.compare-check:checked');
    const btn = document.getElementById('btnCompare');
    const count = document.getElementById('compareCount');
    
    if (checked.length > 0) {
        btn.classList.remove('d-none');
        count.textContent = checked.length;
    } else {
        btn.classList.add('d-none');
    }
}

function goCompare() {
    const checked = document.querySelectorAll('.compare-check:checked');
    const ids = Array.from(checked).map(c => c.value).join(',');
    window.location.href = '/Etkinlik/Karsilastir?ids=' + ids;
}
</script>
}
