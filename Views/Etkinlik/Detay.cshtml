@model art_galeri.Models.Etkinlik
@{ViewData["Title"] = Model.Ad;}
@{var doluluk = (int)Model.DolulukOrani;}

<div class="dashboard-container">
    <div class="row g-4">
        <div class="col-lg-7">
            <div class="panel-card p-0 overflow-hidden">
                @if (!string.IsNullOrEmpty(Model.GorselUrl))
                { <img src="@Model.GorselUrl" class="w-100" style="max-height:380px;object-fit:cover;" alt="@Model.Ad"> }
                else
                { <div style="height:280px;background:var(--bg-gradient);display:flex;align-items:center;justify-content:center;font-size:5rem;">🎭</div> }
            </div>
        </div>
        <div class="col-lg-5">
            <div class="panel-card h-100">
                @if (Model.Kategori != null) { <span class="badge bg-light text-muted mb-2">@Model.Kategori</span> }
                <h2 style="font-family:'Playfair Display',serif;" class="fw-bold">@Model.Ad</h2>
                <p class="text-secondary">@Model.Aciklama</p>
                <ul class="list-unstyled mb-3">
                    <li class="mb-2"><i class="bi bi-calendar3 me-2 text-accent"></i><strong>Tarih:</strong> @Model.Tarih.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("tr-TR"))</li>
                    <li class="mb-2"><i class="bi bi-clock me-2 text-accent"></i><strong>Saat:</strong> @Model.Saat.ToString(@"hh\:mm")</li>
                    <li class="mb-2"><i class="bi bi-geo-alt me-2 text-accent"></i><strong>Konum:</strong> @Model.Konum</li>
                    <li class="mb-2"><i class="bi bi-person me-2 text-accent"></i><strong>Eğitmen:</strong> @(Model.Egitmen?.Ad) @(Model.Egitmen?.Soyad)</li>
                </ul>
                <div class="mb-3">
                    <div class="d-flex justify-content-between small mb-1">
                        <span>Doluluk: @Model.RezervasyonSayisi/@Model.Kapasite kişi</span>
                        <span>%@doluluk</span>
                    </div>
                    <div class="progress-bar-custom"><div class="progress-fill @(doluluk>=90?"dolu":"")" style="width:@doluluk%"></div></div>
                    @if (Model.KalanKapasite > 0) { <small class="text-success">@Model.KalanKapasite kişilik yer kaldı</small> }
                    else { <small class="text-danger fw-bold">Kapasite doldu</small> }
                </div>
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="fw-bold text-success" style="font-size:1.7rem;">@Model.Ucret.ToString("N0") ₺</span>
                    <span class="stars">@for(int i=1;i<=5;i++){@(i<=Math.Round(Model.OrtalamaPuan)?"⭐":"☆")}</span>
                    <small class="text-muted">(@Model.OrtalamaPuan.ToString("F1"))</small>
                </div>
                @if (Model.KalanKapasite > 0)
                {
                    @if (ViewBag.RezerveEttiMi == true)
                    {
                        <div class="alert-custom alert-success"><i class="bi bi-check-circle"></i> Bu etkinlik için rezervasyonunuz mevcut.</div>
                    }
                    else
                    {
                        <a href="/Etkinlik/Rezervasyon/@Model.EtkinlikID" class="btn btn-primary-custom w-100"><i class="bi bi-calendar-check me-1"></i>Rezervasyon Yap</a>
                    }
                }
                else
                {
                    <button class="btn btn-danger w-100 disabled">Kapasite Doldu</button>
                }
            </div>
        </div>
    </div>

    <!-- Yorumlar -->
    <div class="panel-card mt-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="panel-title mb-0"><i class="bi bi-chat-dots text-accent"></i> Değerlendirmeler (@(Model.Yorumlar?.Count() ?? 0))</div>
            <div class="d-flex gap-2 align-items-center">
                <span class="small text-muted">Sırala:</span>
                <select class="form-select form-select-sm" id="sortComments" style="width:140px;">
                    <option value="yeni">En Yeni</option>
                    <option value="puan">En Yüksek Puan</option>
                    <option value="faydali">En Faydalı</option>
                </select>
            </div>
        </div>

        @if (Context.Session.GetInt32("UserID") != null)
        {
            <div class="mb-4">
                @if (ViewBag.RezerveEttiMi == true)
                {
                    <form id="commentForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="etkinlikId" value="@Model.EtkinlikID">
                        <div class="mb-2">
                            <label class="form-label fw-semibold">Puanınız</label>
                            <select name="puan" class="form-select" style="width:180px;">
                                <option value="5">⭐⭐⭐⭐⭐ Mükemmel</option>
                                <option value="4">⭐⭐⭐⭐ Çok İyi</option>
                                <option value="3">⭐⭐⭐ İyi</option>
                                <option value="2">⭐⭐ Orta</option>
                                <option value="1">⭐ Kötü</option>
                            </select>
                        </div>
                        <textarea name="icerik" class="form-control mb-2" rows="3" placeholder="Etkinlik değerlendirmenizi yazın..." required></textarea>
                        <button type="button" onclick="submitComment()" class="btn btn-accent">Değerlendir</button>
                    </form>
                }
                else
                {
                    <div class="alert alert-secondary d-flex align-items-center mb-0 p-3" style="border-left: 4px solid var(--accent-color);">
                        <i class="bi bi-lock-fill fs-4 text-muted me-3"></i>
                        <div>
                            <strong>Değerlendirme Kapalı</strong><br>
                            <span class="small text-muted">Güvenilirlik ve doğrulama gereği, etkinlik yorumu yapabilmek için öncelikle ilgili etkinliğe katılmış olmanız gerekmektedir.</span>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert-custom alert-warning mb-3"><i class="bi bi-info-circle"></i> <a href="/Users/Login" class="auth-link">Giriş yapın</a> ve değerlendirin.</div>
        }

        <div id="commentsList">
            @if (Model.Yorumlar != null && Model.Yorumlar.Any())
            {
                foreach (var y in Model.Yorumlar.Where(y => y.Onaylandi).OrderByDescending(y => y.OlusturulmaTarihi))
                {
                    <div class="yorum-card @(y.Dogrulanmis ? "dogrulanmis" : "")" data-puan="@y.Puan" data-faydali="@y.FaydaliBulma" data-tarih="@y.OlusturulmaTarihi.Ticks">
                        <div class="d-flex justify-content-between">
                            <div>
                                <strong>@y.User?.Ad @y.User?.Soyad</strong>
                                @if (y.Dogrulanmis) { <span class="badge bg-success ms-1" style="font-size:.65rem;">✓ Katılımcı</span> }
                            </div>
                            <span class="stars">@for(int i=1;i<=5;i++){@(i<=y.Puan?"⭐":"☆")}</span>
                        </div>
                        <p class="mb-1 mt-1">@y.Icerik</p>
                        <div class="yorum-meta">
                            @y.OlusturulmaTarihi.ToLocalTime().ToString("dd.MM.yyyy") · 
                            <button class="btn btn-sm btn-link p-0 text-muted" onclick="faydali(@y.YorumID, this)">👍 <span class="count">@y.FaydaliBulma</span> Faydalı</button>
                        </div>
                        @if (!string.IsNullOrEmpty(y.YoneticiYaniti))
                        {
                            <div class="yorum-yanit"><strong>🏛️ Eğitmen Yanıtı:</strong> @y.YoneticiYaniti</div>
                        }
                        else if (Context.Session.GetString("UserRole") == "Yonetici" || (Context.Session.GetString("UserRole") == "Egitmen" && Context.Session.GetInt32("UserID") == Model.EgitmenID))
                        {
                            <button class="btn btn-sm btn-link p-0 mt-1 text-accent" onclick="showResponseForm(@y.YorumID)">Yanıtla</button>
                            <div id="respForm-@y.YorumID" class="mt-2 d-none">
                                <textarea class="form-control form-control-sm mb-1" id="respText-@y.YorumID"></textarea>
                                <button class="btn btn-xs btn-accent" onclick="submitResponse(@y.YorumID)">Gönder</button>
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                <div class="empty-state py-3"><div class="empty-icon">💬</div><p>Henüz değerlendirme yok.</p></div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
function submitComment() {
    const form = document.getElementById('commentForm');
    const formData = new FormData(form);
    fetch('/Yorum/Ekle', { method: 'POST', body: new URLSearchParams(formData) })
        .then(r => r.json()).then(d => {
            if(d.success) { alert(d.message); location.reload(); }
            else alert(d.message);
        });
}

function faydali(id, btn) {
    fetch('/Yorum/Faydali/' + id, { method: 'POST' })
        .then(r => r.json()).then(d => {
            if(d.success) { btn.querySelector('.count').textContent = d.count; btn.disabled = true; }
        });
}

function showResponseForm(id) {
    document.getElementById('respForm-' + id).classList.toggle('d-none');
}

function submitResponse(id) {
    const text = document.getElementById('respText-' + id).value;
    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
    fetch('/Yorum/Yanitla', { 
        method: 'POST', 
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: `yorumId=${id}&yanit=${encodeURIComponent(text)}&__RequestVerificationToken=${token}`
    }).then(r => r.json()).then(d => {
        if(d.success) location.reload();
        else alert(d.message);
    });
}

document.getElementById('sortComments')?.addEventListener('change', function() {
    const val = this.value;
    const list = document.getElementById('commentsList');
    const cards = Array.from(list.querySelectorAll('.yorum-card'));
    
    cards.sort((a, b) => {
        if (val === 'puan') return b.dataset.puan - a.dataset.puan;
        if (val === 'faydali') return b.dataset.faydali - a.dataset.faydali;
        return b.dataset.tarih - a.dataset.tarih;
    });
    
    cards.forEach(c => list.appendChild(c));
});
</script>
}
